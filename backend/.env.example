# Copy to .env and fill in. Everything is optional: without these the app runs
# fully offline with template narration in English, Spanish, French and Swahili.

# --- AI narration, any language, "Ask the match". Set ONE of the two blocks below.
# Option 1: Microsoft Foundry / Azure OpenAI (needs an Azure subscription; used first if set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Option 2: any OpenAI-compatible API (fallback when no Azure subscription is available)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Microsoft Fabric Real-Time Intelligence (Eventstream custom endpoint, Event Hubs protocol)
# Requires: pip install azure-eventhub
FABRIC_EVENTSTREAM_CONNECTION_STRING=
FABRIC_EVENTSTREAM_NAME=
